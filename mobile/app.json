{
  "expo": {
    "name": "Smart Crop Doctor",
    "slug": "smart-crop-disease-detector",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B5E20"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },

    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Smart Crop Doctor requires camera access to photograph diseased plant leaves.",
        "NSPhotoLibraryUsageDescription": "Smart Crop Doctor requires photo library access to diagnose crop photos."
      }
    },
    "android": {
      "package": "com.smartcrop.diseasedetector",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#1B5E20",
        "foregroundImage": "./assets/icon.png"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Smart Crop Doctor needs access to your photos to diagnose plant leaf diseases.",
          "cameraPermission": "Smart Crop Doctor needs camera access to photograph crop leaves in the field."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "4f7b0072-0a01-459e-a62f-87798c01fad9"
      }
    }
  }
}
